<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%> 
<html lang="en">
<head>

<title>admin license tab</title>
<script type="text/javascript">

function submitLicense(){
	ajaxPost({
		url: './siconfig?mode=saveLicense',
		data: $("form[name=licenseForm]").serialize(),
		success: function(result) {
			if(result.status == "fail"){
				$().toastmessage('showErrorToast', 'Unable to save this Activation code ['+ result.msg+']');
			}else{
				$().toastmessage('showSuccessToast', 'Activation code saved successfully!');
				$("#supportFeaturesWrapper").empty();
				$("#deviceCount").text(result.deviceCount);
				$.each(result.licenseDetail,function(index, item){
					$("#supportFeaturesWrapper").append("<tr><td>"+item.feature+"</td><td>"+item.status+"</td><td>"+item.deviceLimit+"</td><td>"+item.expireDate+"</td></tr>");
				});
				if(result.isHaveLicense){
					$("#licenceInfo").show();
				}else{
					$("#licenceInfo").hide();
				}
				resolveMyChoiceTemplateMenu();
			}
		}
	});
}

</script>
</head>
<body>
	<div style="margin: auto;width:50%; text-align: center;">
	
		<div><h3 style="text-align:center;margin-bottom: 30px;">License</h3></div>
		<form class="form-horizontal" role="form" method="post" name="licenseForm" aria-label="license">
			<div class="form-group">
				<label class="col-sm-4 control-label">Serial Number</label>
				<div class="col-sm-8">
					<input class="form-control" style="width:80%" readonly value="<c:out value="${licenseInfo.serialNumber}"/>"/>
				</div>
			</div>
			<div class="form-group">
				<label class="col-sm-4 control-label">Activation code</label>
				<div class="col-sm-8">
					<input class="form-control" style="width:80%" name="licenseActivationCode" value="<c:out value="${licenseInfo.licenseActivationCode}"/>" />
				</div>
			</div>
			<div class="form-group">
		      <div class="col-sm-offset-2 col-sm-8">
		         <button type="button" class="btn btn-primary" onclick="submitLicense()">Request License</button>
		      </div>
		   </div>
		    <hr/>
		    
			<div id="licenceInfo" class="form-group" style="display: ${licenseInfo.isHaveLicense?"block":"none"};">
				<div class="col-sm-offset-2 col-sm-10 text-left">Your device count is  <b id="deviceCount">${licenseInfo.deviceCount}</b></div>
				<div class="col-sm-offset-2 col-sm-10">
					<table class="table">
						<caption>Supported features</caption>
		  			 	<thead>
					      <tr>
					         <th class="text-center">Feature</th>
					         <th class="text-center">License Status</th>
					         <th class="text-center">Device limit</th>
					         <th class="text-center">License Expire Date</th>
					      </tr>
					  	</thead>
						   <tbody id="supportFeaturesWrapper">
						   <c:forEach items="${licenseInfo.licenseDetail}" var="item" >
						    <tr>
						         <td>${item.feature}</td>
						         <td>${item.status}</td>
						         <td>${item.deviceLimit}</td>
						         <td>${item.expireDate}</td>
						      </tr>
			       		   </c:forEach>
						   </tbody>
						</table>
				</div>
			</div>
		</form>
	</div>
</body>
</html>