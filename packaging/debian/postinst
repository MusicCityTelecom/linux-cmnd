#!/bin/sh
set -eu
VERSION=$(dpkg-query -W -f='${Version}' linux-cmnd)
VERSION=${VERSION%%-*}
getent group cmnd >/dev/null || addgroup --system cmnd
id cmnd >/dev/null 2>&1 || adduser --system --ingroup cmnd --home /var/lib/cmnd --no-create-home --disabled-login cmnd
install -d -o root -g root -m 0755 /opt/linux-cmnd/releases
install -d -o cmnd -g cmnd -m 0750 /opt/cmnd/releases /var/lib/cmnd /var/log/cmnd
install -d -o root -g cmnd -m 0750 /etc/cmnd
chown root:cmnd /etc/cmnd/cmnd.toml
chmod 0640 /etc/cmnd/cmnd.toml
ln -sfn "releases/$VERSION" /opt/linux-cmnd/current
if [ -e /etc/cmnd/deployment.json ] || [ -L /etc/cmnd/deployment.json ]; then
  # A tooling update must not regenerate an active site's native/auxiliary
  # configuration. Validate the root-owned marker rather than trusting its name.
  python3 -c '
import json, pathlib, sys
p=pathlib.Path("/etc/cmnd/deployment.json")
safe=p.is_file() and not p.is_symlink() and p.stat().st_uid==0 and not p.stat().st_mode & 0o022 and p.stat().st_size<65536
data=json.loads(p.read_text())
managed=data.get("managed_by") in {"linux-cmnd-native","linux-cmnd-apt","linux-cmnd-coexist"}
sys.exit(0 if safe and managed and data.get("state")=="active" else 1)
'
else
  CMND_CONFIG=/etc/cmnd/cmnd.toml PYTHONPATH="/opt/linux-cmnd/releases/$VERSION/src" \
    python3 -m cmnd_linux render-runtime-config --output /etc/cmnd --execute
fi
for rendered in tomcat.env apache.env compose.env; do
  path="/etc/cmnd/$rendered"
  if [ -e "$path" ] || [ -L "$path" ]; then
    [ -f "$path" ] && [ ! -L "$path" ] || { echo "Unsafe CMND rendered config: $path" >&2; exit 1; }
    chown root:cmnd "$path"
    chmod 0640 "$path"
  fi
done
exit 0
