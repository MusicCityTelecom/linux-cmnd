# This repository is developed beside licensed/private CMND source artifacts.
# Deny by default so vendor binaries, captures, certificates, backups, and
# customer data cannot be committed accidentally.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/CHANGELOG.md
!/LICENSE
!/VERSION
!/pyproject.toml
!/packaging/
!/packaging/**
!/scripts/
!/scripts/**
!/config/
!/config/**
!/deploy/
!/deploy/**
!/docs/
!/docs/**
!/src/
!/src/**
!/tests/
!/tests/**

# Generated/runtime data inside allowed trees.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/*.log
**/*.p12
**/*.pem
**/*.key
**/*.crt
**/*.sql
**/*.zip
**/*.war
**/*.jar
**/*.exe
**/*.pcap
**/*.pcapng
**/.env
**/secrets/
**/state/
**/backups/
**/support-bundles/

# Explicitly reviewed research source only. Publication validation rejects
# executable/binary artifacts here; those belong in research release assets.
!/recovered/
!/recovered/**

# Editable native research project. Runtime resources and binaries are prepared
# locally from verified release assets, never committed as source.
!/native-project/
!/native-project/**
/native-project/.vendor/
/native-project/build/
/native-project/resources/
/native-project/working/
**/*.class
**/*.jar
**/*.war
**/*.zip
**/*.exe
**/*.dll
**/*.p12
**/*.pem
**/*.key
**/*.crt
**/*.sql
